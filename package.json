{
  "name": "@wattpad/cli",
  "version": "1.0.0",
  "description": "Wattpad CLI: Herramienta de terminal para gestionar novelas, capítulos, documentos Word, Bloc de notas y Google Docs con sincronización oficial",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "wattpad": "src/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "package.json"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MiguelCarlosRojas/Wattpad-CLI.git"
  },
  "bugs": {
    "url": "https://github.com/MiguelCarlosRojas/Wattpad-CLI/issues"
  },
  "homepage": "https://github.com/MiguelCarlosRojas/Wattpad-CLI#readme",
  "scripts": {
    "build": "tsc --noEmit",
    "start": "bun run src/index.ts",
    "start:server": "bun run src/server.ts",
    "server": "bun run src/server.ts",
    "dev": "bun run src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opentui/core": "^0.9.2",
    "docx": "^9.15.4",
    "dotenv": "^18.0.10",
    "googleapis": "^190.0.0",
    "mammoth": "^1.13.0",
    "playwright-core": "^1.65.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3"
  }
}
