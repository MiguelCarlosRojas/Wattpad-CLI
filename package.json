{
  "name": "@wattpad/cli",
  "version": "1.1.0",
  "description": "Wattpad CLI: Herramienta de terminal para gestionar novelas, capítulos, documentos Word, Bloc de notas y Google Docs con sincronización oficial",
  "type": "module",
  "main": "src/cli/main.ts",
  "bin": {
    "wattpad": "bin/wattpad.cjs"
  },
  "files": [
    "bin",
    "README.md",
    "package.json"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MiguelCarlosRojas/Wattpad-CLI.git"
  },
  "bugs": {
    "url": "https://github.com/MiguelCarlosRojas/Wattpad-CLI/issues"
  },
  "homepage": "https://github.com/MiguelCarlosRojas/Wattpad-CLI#readme",
  "scripts": {
    "dev": "bun run src/cli/main.ts",
    "dev:api": "bun --watch src/api/server.ts",
    "dev:cli": "bun run src/cli/main.ts",
    "build": "bun run build:api",
    "build:api": "bun build src/api/server.ts --target=bun --outfile=dist/server.js",
    "start": "bun run start:api",
    "start:api": "bun run dist/server.js || bun run src/api/server.ts",
    "build:cli": "bun run scripts/build-cli.ts",
    "build:checksums": "bun run scripts/generate-checksums.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@opentui/core": "^0.9.2",
    "docx": "^9.15.4",
    "dotenv": "^18.0.10",
    "googleapis": "^190.0.0",
    "mammoth": "^1.13.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3"
  }
}
